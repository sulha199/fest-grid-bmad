{
  "name": "@festgrid/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "default": "./dist/query/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "default": "./dist/events/index.js"
    },
    "./geolocation": {
      "types": "./dist/geolocation/index.d.ts",
      "default": "./dist/geolocation/index.js"
    },
    "./user-locations": {
      "types": "./dist/user-locations/index.d.ts",
      "default": "./dist/user-locations/index.js"
    },
    "./user-settings": {
      "types": "./dist/user-settings/index.d.ts",
      "default": "./dist/user-settings/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "default": "./dist/email/index.js"
    },
    "./ai-event-filters": {
      "types": "./dist/ai-event-filters/index.d.ts",
      "default": "./dist/ai-event-filters/index.js"
    },
    "./ai-gateway": {
      "types": "./dist/ai-gateway/index.d.ts",
      "default": "./dist/ai-gateway/index.js"
    },
    "./subscriptions": {
      "types": "./dist/subscriptions/index.d.ts",
      "default": "./dist/subscriptions/index.js"
    },
    "./scraper": {
      "types": "./dist/scraper/index.d.ts",
      "default": "./dist/scraper/index.js"
    },
    "./posts": {
      "types": "./dist/posts/index.d.ts",
      "default": "./dist/posts/index.js"
    },
    "./users": {
      "types": "./dist/users/index.d.ts",
      "default": "./dist/users/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf .turbo node_modules dist",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@festgrid/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@festgrid/eslint-config": "workspace:*",
    "@festgrid/typescript-config": "workspace:*",
    "@types/node": "^20.14.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
