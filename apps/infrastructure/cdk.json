{
  "app": "tsx bin/infrastructure.ts",
  "watch": {
    "include": [
      "**"
    ],
    "exclude": [
      "README.md",
      "cdk.json",
      "tsconfig.json",
      "package.json",
      "node_modules",
      "cdk.out"
    ]
  },
  "context": {
    "@aws-cdk/aws-apigateway:usagePlanKeyOrderInsensitiveId": true,
    "@aws-cdk/core:stackRelativeExports": true,
    "@aws-cdk/aws-rds:databaseInsensitiveClusterId": true,
    "@aws-cdk/aws-lambda:recognizeVersionProps": true,
    "@aws-cdk/aws-lambda:recognizeLayerVersionDeclaration": true,
    "@aws-cdk/aws-cloudfront:defaultSecurityPolicyTLSv1.2_2021": true,
    "@aws-cdk/core:checkCertificateImportingState": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-sns-subscriptions:restrictSqsDescryption": true,
    "@aws-cdk/aws-apigateway:disableCloudWatchRole": true,
    "@aws-cdk/core:enablePartitionLiterals": true,
    "@aws-cdk/aws-ec2:uniqueImdsv2TemplateName": true,
    "@aws-cdk/aws-ecs:arnFormatIncludesClusterName": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:validateKeysNoEmptyStrings": true,
    "@aws-cdk/aws-codepipeline:useLatestWithReplacePlaceholderInRuntimeVariables": true,
    "@aws-cdk/aws-route53-patters:useCertificate": true,
    "@aws-cdk/aws-kms:aliasNameRef": true,
    "@aws-cdk/aws-s3:keepNotificationInImportedBucket": true,
    "@aws-cdk/aws-elasticloadbalancingv2:albDualstackHeader": true,
    "@aws-cdk/aws-customresources:utcFargateSg": true,
    "@aws-cdk/aws-iam:standardizedServicePrincipals": true,
    "@aws-cdk/aws-ecs:disableExplicitReceiver": true,
    "@aws-cdk/aws-appsync:useFormatForApiKeyAndSchema": true,
    "@aws-cdk/aws-rds:preventLogExportsSubsystem": true,
    "@aws-cdk/aws-codepipeline-actions:useNewCustomResource": true,
    "@aws-cdk/aws-lambda-nodejs:useLatestEsbuildVersion": true
  }
}
