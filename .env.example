# Root environment defaults for the monorepo
# Copy this file to .env and set values for your environment.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/festgrid"

# Supabase
SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY="phc_placeholder_key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_POSTHOG_DEFAULTS="2026-05-30"

# Geolocation API Key
# backend uses this to call the Geolocation API
GEOAPIFY_API_KEY=
# frontend uses this to call the Geolocation API, this is the public key, which is safe to expose in the frontend code
NEXT_PUBLIC_GEOAPIFY_MAPS_API_KEY=

# Firebase Cloud Messaging (FCM)
# Backend / Admin SDK (do not prefix with NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Frontend / JS SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# AWS Simple Email Service (SES)
SES_FROM_EMAIL_ADDRESS=
# The developer/administrator inbox that receives reportSystemError alerts
SYSTEM_ERROR_ALERT_EMAIL=
# Frontend base URL for links in moderation emails
WEB_APP_BASE_URL="http://localhost:3000"

# AI Gateway (Google Gemini API)
# Populated automatically post-deploy via AWS KMS (provisioned in Story 0.14)
BYOK_KMS_KEY_ID=
GEMINI_MODEL="gemini-3.5-flash-lite"
API_KEY_INVALID_ATTEMPTS_THRESHOLD="5"
API_KEY_USAGE_CYCLE_DAYS="30"

# Scraper pipeline (Story 3.4)
# Populated automatically post-deploy via CDK (ScrapingQueue URL, Story 0.14)
SCRAPING_QUEUE_URL=

# AI processing and Ingestion pipeline (Stories 3.5 & 3.6)
# Provisioned by Story 0.14's IaC but — unlike SCRAPING_QUEUE_URL — AI_PROCESSING_QUEUE_URL is NOT yet
# wired into any Lambda's CDK environment block, since no caller exists inside
# a Lambda until Story 5.1a adds the real selectPostsForExtraction resolver.
AI_PROCESSING_QUEUE_URL=
# DATA_INGESTION_QUEUE_URL is used by Story 3.6's AI Processor Lambda to enqueue validated results for ingestion.
# Unlike AI_PROCESSING_QUEUE_URL, this is wired into a real Lambda's CDK environment (aiProcessorLambda) by Story 3.6.
DATA_INGESTION_QUEUE_URL=
# App-funded Apify API token (NOT a per-user BYOK key) - see SETUP_WALKTHROUGH.md
APIFY_API_TOKEN=
SCRAPE_RESULTS_LIMIT="10"
SCRAPE_INITIAL_LOOKBACK_DAYS="7"
SCRAPE_SKIP_RECENT_HOURS="20"
# Apify free-plan budget/rate - revisit if Apify's pricing changes
SCRAPER_MONTHLY_BUDGET_USD="5.00"
SCRAPER_PRICE_PER_1000_ITEMS_USD="2.70"
SCRAPER_CAPACITY_THRESHOLD_RATIO="0.9"
SCRAPER_USAGE_CYCLE_DAYS="30"

# Queue notifications for stale posts due to API quota issues
# Default: 3 days of stale posts before sending notification
QUEUE_NOTIFICATION_THRESHOLD_DAYS="3"
# Default: 3 stale posts minimum before sending notification
QUEUE_NOTIFICATION_THRESHOLD_COUNT="3"
# Default: 7 days cooldown between quota warning emails to the same user
QUEUE_NOTIFICATION_COOLDOWN_DAYS="7"
