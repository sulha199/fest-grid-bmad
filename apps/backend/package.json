{
  "name": "backend",
  "version": "1.0.0",
  "description": "GraphQL backend for FestGrid",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "lint": "eslint . --report-unused-disable-directives",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "cross-env NODE_ENV=test tsx --test --test-concurrency=1 src/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1058.0",
    "@aws-sdk/client-s3": "^3.1100.0",
    "@aws-sdk/client-sesv2": "^3.1100.0",
    "@aws-sdk/client-sqs": "^3.1100.0",
    "@escape.tech/graphql-armor": "^3.2.0",
    "@festgrid/database": "workspace:*",
    "@festgrid/domain": "workspace:*",
    "@festgrid/graphql-select": "workspace:*",
    "@festgrid/shared-types": "workspace:*",
    "@google/genai": "^2.14.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "apify-client": "^2.0.0",
    "drizzle-orm": "^0.30.10",
    "firebase-admin": "^14.1.0",
    "graphql": "^16.8.0",
    "graphql-scalars": "^1.23.0",
    "graphql-yoga": "^5.21.2",
    "jose": "^6.2.6",
    "node-fetch": "^3.3.2",
    "postgres": "^3.4.4",
    "tldts": "^7.4.10"
  },
  "devDependencies": {
    "@festgrid/eslint-config": "workspace:*",
    "@festgrid/typescript-config": "workspace:*",
    "@graphql-codegen/add": "^5.0.3",
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/typescript": "^4.0.9",
    "@graphql-codegen/typescript-resolvers": "^4.2.1",
    "@types/aws-lambda": "^8.10.145",
    "dotenv": "^16.4.5",
    "eslint": "^9.9.0",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5"
  }
}
