{
  "name": "@festgrid/database",
  "version": "1.0.0",
  "description": "Drizzle ORM schema and migrations for FestGrid",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "generate": "drizzle-kit generate",
    "migrate": "tsx migrate.ts",
    "seed": "tsx seed.ts",
    "test:seed": "tsx --test seed.integration.test.ts",
    "migrate:prod": "node dist/migrate.js",
    "studio": "drizzle-kit studio",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "drizzle-orm": "^0.30.10",
    "postgres": "^3.4.4",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.21.2",
    "@festgrid/typescript-config": "workspace:*",
    "@festgrid/eslint-config": "workspace:*",
    "typescript": "^5.4.5",
    "tsx": "^4.9.0"
  }
}
