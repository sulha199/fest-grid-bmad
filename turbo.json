{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NEXT_PUBLIC_POSTHOG_KEY", "NEXT_PUBLIC_POSTHOG_HOST", "NEXT_PUBLIC_POSTHOG_DEFAULTS", "ALLOW_DESTRUCTIVE_SEED", "BACKEND_GRAPHQL_URL"],
  "tasks": {
    "codegen": {
      "dependsOn": [],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "codegen"],
      "env": ["NEXT_PUBLIC_POSTHOG_KEY", "NEXT_PUBLIC_POSTHOG_HOST", "NEXT_PUBLIC_POSTHOG_DEFAULTS"],
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {
      "dependsOn": [],
      "env": ["NEXT_PUBLIC_POSTHOG_KEY", "NEXT_PUBLIC_POSTHOG_HOST", "NEXT_PUBLIC_POSTHOG_DEFAULTS"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_POSTHOG_KEY", "NEXT_PUBLIC_POSTHOG_HOST", "NEXT_PUBLIC_POSTHOG_DEFAULTS"]
    },
    "db:push": {
      "dependsOn": [],
      "env": ["DATABASE_URL"]
    },
    "migrate": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["NEXT_PUBLIC_POSTHOG_KEY", "NEXT_PUBLIC_POSTHOG_HOST", "NEXT_PUBLIC_POSTHOG_DEFAULTS"]
    }
  }
}
